{
  "name": "@sightings/prisma",
  "version": "0.1.0",
  "description": "Prisma storage adapter for sightings.",
  "license": "MIT",
  "author": "Igor Katsuba <igor@katsuba.dev>",
  "homepage": "https://github.com/IKatsuba/sightings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IKatsuba/sightings.git",
    "directory": "packages/prisma"
  },
  "keywords": [
    "sightings",
    "prisma",
    "analytics",
    "cookieless"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "prisma"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sighting.prisma": "./prisma/sighting.prisma",
    "./sighting.sql": "./prisma/sighting.sql",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "sightings": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
